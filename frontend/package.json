{
	"name": "wikibase-ecosystem",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "vite preview",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui --coverage.enabled=true",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"lint": "eslint . --fix",
		"lint-check": "eslint .",
		"format": "prettier --write ./",
		"format-check": "prettier --check ./",
		"codegen": "graphql-codegen"
	},
	"dependencies": {
		"@apollo/client": "^3.14.1",
		"@mdi/js": "^7.4.47",
		"@vue/apollo-composable": "^4.2.2",
		"graphql": "^16.14.2",
		"pinia": "^4.0.3",
		"serve": "^14.2.6",
		"vue": "^3.5.43",
		"vue-matomo": "^4.2.0",
		"vuetify": "^4.2.4"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/client-preset": "^6.2.3",
		"@graphql-codegen/typescript": "^6.1.2",
		"@graphql-codegen/typescript-operations": "^6.1.10",
		"@graphql-codegen/typescript-vue-apollo": "^5.0.1",
		"@tsconfig/node22": "^22.0.6",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.5",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vitejs/plugin-vue-jsx": "^5.1.6",
		"@vitest/coverage-istanbul": "^5.0.4",
		"@vitest/eslint-plugin": "^1.6.27",
		"@vitest/ui": "^5.0.4",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.12.0",
		"eslint-plugin-vue": "^10.11.1",
		"jiti": "^2.7.0",
		"jsdom": "^29.1.1",
		"npm-run-all2": "^8.0.4",
		"prettier": "^3.9.10",
		"sass-embedded": "^1.105.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vitest": "^5.0.4",
		"vue-tsc": "^3.3.13"
	}
}
